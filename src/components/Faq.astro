---
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
}
const { items, heading = 'Common questions' } = Astro.props;
---
<section class="faq">
  <h2>{heading}</h2>
  {items.map((i) => (
    <details>
      <summary>{i.q}</summary>
      <p set:html={i.a} />
    </details>
  ))}
</section>
